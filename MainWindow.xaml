<Window x:Class="InspectionMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="제조 검사 데이터 조회"
        Width="1000"
        Height="760"
        MinWidth="850"
        MinHeight="650"
        FontFamily="Malgun Gothic"
        FontSize="14"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock Text="제조 검사 데이터 조회"
                       FontSize="25"
                       FontWeight="Bold"/>
            <TextBlock Text="가상 검사 데이터, 학습용 기준: 5.0 이상 6.0이하"
                       Margin="0,6,0,0"
                       Foreground="#666666"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,18">
            <TextBlock Text="검사 날짜"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <DatePicker x:Name="InspectionDatePicker"
                        Width="150"
                        Margin="0,0,20,0"/>
            <TextBlock Text="설비"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="EquipmentComboBox"
                      Width="130"
                      Margin="0,0,20,0">
                <ComboBoxItem Content="전체"/>
                <ComboBoxItem Content="설비 A"/>
                <ComboBoxItem Content="설비 B"/>
                <ComboBoxItem Content="설비 C"/>
            </ComboBox>

            <Button x:Name="SearchButton"
                    Content="조회"
                    Width="90"
                    Padding="8,4"
                    Click="SearchButton_Click"/>
            <Button Content="공개 데이터 (SECOM)"
                    Margin="10,0,0,0"
                    Padding="12,4"
                    Click="OpenSecom_Click"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                Padding="14"
                Margin="0,0,0,16"
                CornerRadius="6">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        TextElement.FontSize="18">

                <TextBlock Text="총 검사 수: "/>
                <TextBlock x:Name="TotalCountText"
                           FontWeight="Bold"
                           Margin="0,0,30,0"/>
                <TextBlock Text="NG 수: "/>
                <TextBlock x:Name="NgCountText"
                           FontWeight="Bold"
                           Foreground="#C62828"
                           Margin="0,0,30,0"/>
                <TextBlock Text="불량률: "/>
                <TextBlock x:Name="NgRateText"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="ResultGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ColumnWidth="*"
                  RowHeight="30"
                  HeadersVisibility="Column"
                  Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="검사 번호"
                                    Binding="{Binding Id}"/>

                <DataGridTextColumn Header="검사 시각"
                                    Binding="{Binding DisplayTime}"/>

                <DataGridTextColumn Header="설비"
                                    Binding="{Binding Equipment}"/>

                <DataGridTextColumn Header="검사값"
                                    Binding="{Binding DisplayValue}"/>

                <DataGridTextColumn Header="판정"
                                    Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <Border Grid.Row="4"
                Background="White"
                Padding="14"
                CornerRadius="6">

            <StackPanel>
                <TextBlock Text="설비별 불량률"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Width="640"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1">
                        <TextBlock Text="0%"
                                   HorizontalAlignment="Left"/>

                        <TextBlock Text="50%"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="100%"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <ItemsControl x:Name="EquipmentChart">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="640"
                                  HorizontalAlignment="Left"
                                  Margin="0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Equipment}"
                                           VerticalAlignment="Center"/>

                                <Grid Grid.Column="1"
                                      Height="24"
                                      Background="#E8EDF3">

                                    <Rectangle Width="{Binding BarWidth}"
                                               Height="24"
                                               Fill="#357ABD"
                                               HorizontalAlignment="Left"/>
                                </Grid>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ChartEmptyText"
                           Text="조회 결과가 없습니다."
                           Margin="0,10,0,5"
                           Foreground="#666666"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>