<Window x:Class="InspectionMonitor.SecomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공개 반도체 검사 데이터"
        Width="1100" Height="720" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="14" Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="공개 반도체 검사 데이터" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="UCI SECOM · 원본 검사 시각과 합격·불합격 판정" Foreground="#526176"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Label Content="시작일" Target="{Binding ElementName=FromDatePicker}"/>
            <DatePicker x:Name="FromDatePicker" Width="135" Margin="4,0,8,0"/>
            <Label Content="종료일" Target="{Binding ElementName=ToDatePicker}"/>
            <DatePicker x:Name="ToDatePicker" Width="135" Margin="4,0,12,0"/>
            <Button x:Name="SecomSearchButton" Content="조회" Width="80"
                    Click="Search_Click" Margin="0,0,8,0"/>
            <Button x:Name="ImportButton" Content="판정 파일 가져오기" Padding="12,4"
                    Click="Import_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <TextBlock x:Name="SummaryText" FontSize="17" FontWeight="Bold" Text="조회 대기"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="452"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" Padding="14" CornerRadius="6" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="주별 불합격률" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="월요일 시작 · 막대 범위 0~100% · 불합격/전체"
                                   Foreground="#526176" FontSize="12"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WeekChart">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="92"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding WeekStart, StringFormat={}{0:MM-dd}}"/>
                                        <Grid Grid.Column="1" Background="#E8EDF3" Height="20">
                                            <Rectangle Width="{Binding BarWidth}" Fill="#2869A8"
                                                       HorizontalAlignment="Left"/>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Counts}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <CheckBox x:Name="NgOnlyCheckBox" DockPanel.Dock="Top" Content="불합격 기록만 보기"
                          Checked="NgFilter_Changed" Unchecked="NgFilter_Changed" Margin="0,0,0,8"/>
                <DataGrid x:Name="SecomResultGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="원본 행 번호" Binding="{Binding Id}" Width="100"/>
                        <DataGridTextColumn Header="검사 시각"
                                            Binding="{Binding InspectedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                        <DataGridTextColumn Header="판정" Binding="{Binding Status}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap"
                   Margin="0,10,0,0" Foreground="#526176"/>
    </Grid>
</Window>
